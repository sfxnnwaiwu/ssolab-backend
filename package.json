{
    "name": "sso-test-backend",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "pnpm typeorm migration:generate -d src/config/data-source.ts",
        "migration:create": "pnpm typeorm migration:create",
        "migration:run": "pnpm typeorm -- migration:run -d src/config/data-source.ts",
        "migration:revert": "pnpm typeorm migration:revert -d src/config/data-source.ts",
        "migration:show": "pnpm typeorm migration:show -d src/config/data-source.ts"
    },
    "packageManager": "pnpm@10.28.2",
    "dependencies": {
        "@nestjs/cache-manager": "^3.1.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^8.0.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.0",
        "@node-saml/node-saml": "^5.1.0",
        "@sendgrid/mail": "^8.1.6",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express-session": "^1.18.2",
        "@types/passport-jwt": "^4.0.1",
        "@types/passport-local": "^1.0.38",
        "bcrypt": "^6.0.0",
        "cache-manager": "^7.2.8",
        "cache-manager-redis-yet": "^5.1.5",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.3",
        "colorette": "^2.0.20",
        "connect-redis": "^9.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.3.1",
        "express-session": "^1.19.0",
        "helmet": "^8.1.0",
        "nestjs-pino": "^4.5.0",
        "openid-client": "^6.8.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "passport-local": "^1.0.0",
        "pg": "^8.18.0",
        "pino": "^10.3.0",
        "pino-http": "^11.0.0",
        "redis": "^5.10.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "swagger-ui-express": "^5.0.0",
        "typeorm": "^0.3.28",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.10.7",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}

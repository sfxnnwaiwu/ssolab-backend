# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=sso_test
DATABASE_SCHEMA=public

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
CACHE_MAX_ITEMS=1000
CACHE_TTL=60000

# Session
SESSION_SECRET=your-super-secret-session-key-change-in-production

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:4200

# RabbitMQ (Optional - not currently used)
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_QUEUE_NAME=sso-test-queue
RABBITMQ_URI_SCHEME=amqp


SAML_CALLBACK_URL=https://hydrocodone-actor-madonna-offerings.trycloudflare.com/api/saml/callback
FRONTEND_URL=https://percent-trusted-janet-functioning.trycloudflare.com   
SAML_ENTRY_POINT=http://localhost:3000/auth/saml/login
SAML_ISSUER=https://hydrocodone-actor-madonna-offerings.trycloudflare.com
BACKEND_BASE_URL=https://hydrocodone-actor-madonna-offerings.trycloudflare.com

# Environment Configuration Example
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=production

# PostgreSQL Configuration
POSTGRES_DB=sso_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password
REDIS_PORT=6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

# Application URLs
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:8080

# Port Configuration
BACKEND_PORT=3000
FRONTEND_PORT=8080
